diff --git a/test/gpu/sortReservationTests.ts b/test/gpu/sortReservationTests.ts
new file mode 100644
index 0000000..ede1e02
--- /dev/null
+++ b/test/gpu/sortReservationTests.ts
@@ -0,0 +1,113 @@
+import type { WebGPURenderer } from "three/webgpu";
+import {
+  ArrayData, GpuArrays, SortKeys, SplatRenderer, WgpuBuffer, WgpuRadixSort, WgpuSplatSorter,
+  getGpuCaps, type SortKeyBits,
+} from "@sparkjsdev/radix";
+
+const BITS: SortKeyBits[] = [16, 24, 32];
+const COUNTS = [2049, 0, 1, 2048, 8193, 32769];
+
+function testKeys(count: number, bits: SortKeyBits) {
+  return Uint32Array.from({ length: count }, (_, i) => {
+    // Consecutive ties span block boundaries; interleave invalid keys.
+    const key = Math.imul((i + 1) >> 1, 0x9e3779b1) >>> (32 - bits);
+    return i % 7 === 0 ? SortKeys.invalid(bits) : key % (SortKeys.validMax(bits) + 1);
+  });
+}
+
+function mismatch(actual: Uint32Array, expected: Uint32Array) {
+  return expected.findIndex((value, i) => value !== actual[i]);
+}
+
+// Read back both buffers of the generic direct sort, across every key width.
+async function checkDirect(renderer: WebGPURenderer, input: Uint32Array<ArrayBuffer>, bits: SortKeyBits, withReservation: boolean) {
+  const keys = new WgpuBuffer({ renderer, format: "uint32", count: input.length });
+  const values = new WgpuBuffer({ renderer, format: "uint32", count: input.length });
+  const sorter = new WgpuRadixSort({ renderer, keys, values });
+  try {
+    if (withReservation) {
+      sorter.reserveCapacity();
+    }
+    keys.upload(input);
+    values.upload(Uint32Array.from(input, (_, i) => i));
+    sorter.sort(input.length, { bits });
+    const { ordering } = SortKeys.sort({ keys: input, count: input.length, bits, ordering: new Uint32Array(input.length) });
+    if (mismatch(await values.read(), ordering) >= 0 || mismatch(await keys.read(), Uint32Array.from(ordering, (i) => input[i])) >= 0) {
+      return `${bits} bits: incorrect direct keys or values`;
+    }
+  } finally {
+    sorter.dispose();
+    values.dispose();
+    keys.dispose();
+  }
+}
+
+// The focused harness also runs the same output checks against npm 0.0.1.
+export async function checkSortReservation(renderer: WebGPURenderer, withReservation = true): Promise<string | undefined> {
+  if (getGpuCaps(renderer).backend !== "webgpu") {
+    const splats = new SplatRenderer({ renderer });
+    try {
+      if (withReservation) {
+        splats.reserveSortCapacity(8193);
+      }
+      return (await splats.readSortedCount()) === 0 ? undefined : "WebGL2 reserve changed the sorted count";
+    } finally {
+      splats.dispose();
+    }
+  }
+
+  for (const bits of BITS) {
+    const keys = testKeys(COUNTS.at(-1)!, bits);
+    const direct = await checkDirect(renderer, keys, bits, withReservation);
+    if (direct) {
+      return direct;
+    }
+    const data = new ArrayData({ count: keys.length }).addBundle("sortKeys", SortKeys.KEYS, { data: { key: new Uint8Array(keys.buffer) } });
+    const arrays = GpuArrays.fromData(renderer, data);
+    const lazy = new WgpuSplatSorter(renderer);
+    const reserved = withReservation ? new WgpuSplatSorter(renderer) : undefined;
+    const sorters = reserved ? [lazy, reserved] : [lazy];
+    try {
+      if (reserved) {
+        reserved.reserveCapacity(8193);
+        const firstBuffer = reserved.values.gpuBuffer();
+        reserved.reserveCapacity(8193);
+        reserved.reserveCapacity(1024);
+        if (reserved.values.gpuBuffer() !== firstBuffer) {
+          return "repeated or smaller reservation replaced the current values buffer";
+        }
+      }
+      for (const count of COUNTS) {
+        const { ordering, visible } = SortKeys.sort({ keys, count, bits });
+        const indexCount = WgpuSplatSorter.QUADS_PER_INSTANCE * 6;
+        const instances = Math.ceil(visible / WgpuSplatSorter.QUADS_PER_INSTANCE);
+        const expectedArgs = Uint32Array.of(indexCount, instances, 0, 0, 0);
+        for (const sorter of sorters) {
+          sorter.sort(arrays, count, bits);
+          if (await sorter.readCount() !== visible) {
+            return `${bits} bits, ${count} keys: incorrect visible count`;
+          }
+          if (mismatch(await sorter.indirect.read(0, 5), expectedArgs) >= 0) {
+            return `${bits} bits, ${count} keys: incorrect indirect draw args`;
+          }
+          if (visible > 0 && mismatch(await sorter.values.read(0, visible), ordering.subarray(0, visible)) >= 0) {
+            return `${bits} bits, ${count} keys: incorrect sorted order`;
+          }
+        }
+        if (reserved && count === COUNTS[0]) {
+          // Late reservation must preserve the current order, including after
+          // the odd 24-bit pass count trades the active and scratch buffers.
+          reserved.reserveCapacity(24_001);
+          if (mismatch(await reserved.values.read(0, visible), ordering.subarray(0, visible)) >= 0) {
+            return `${bits} bits: late reservation discarded current values`;
+          }
+        }
+      }
+    } finally {
+      arrays.dispose();
+      lazy.dispose();
+      reserved?.dispose();
+    }
+  }
+  return undefined;
+}
